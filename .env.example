# このファイルをコピーして .env を作り、値を埋める。
#
#   copy .env.example .env
#
# .env は .gitignore で除外してあるのでコミットされない。
# .env.example のほう（このファイル）には絶対に本物の値を書かないこと。

# Discord Developer Portal > Bot > 「トークンをリセット」で発行した値。
# 例: DISCORD_TOKEN=MTIzNDU2Nzg5...
DISCORD_TOKEN=

# 既定の話者ID。3 = ずんだもん（ノーマル）
# 一覧は python src/voice_countdown.py --list-speakers で見られる
VOICEVOX_SPEAKER=3

# 既定の話す速さ。ずんだもんは1.2で全数字が1秒に収まる
VOICEVOX_SPEED=1.2

# パネルに並べるボタン。カンマ区切りで、それぞれ「その秒数から、パネルで選んだ終わりまで」を読む。
# Discordの制限で1行5個・最大5行。一番上は終わりの選択欄、最下段は停止ボタンが使うので、秒数は15個まで。
# 増やしたら、その秒数の音声を先に焼いておくこと（初回だけ時間がかかる）。
COUNTDOWN_PRESETS=80,75,70,65,60,55,50,45,40

# 起動したときにパネルを貼るチャンネルのID。カンマ区切りで複数可。空なら貼らない。
# ボイスチャンネルのチャット欄に貼るときは、ボイスチャンネルのIDをそのまま書く。
# IDは Discord の 設定 > 詳細設定 > 開発者モード をオンにして、チャンネルを右クリック > IDをコピー。
# ゲーム用のサーバーは通知がうるさくなるので、今はテストサーバーだけにしている。
PANEL_CHANNEL_IDS=
