# Discord Botのトークンなどの秘密情報。絶対にコミットしない
.env

# 仮想環境
.venv/

# 動作の記録（手元に残るだけでよい）
logs/

# 生成した音声（作り直せるのでコミットしない）
voice/*.wav

# サーバーごとのパネル設定（Botが書き換える）
panel_settings.json
panel_settings.json.tmp

# 起動時に貼ったパネルの記録（Botが書き換える）
announced_panels.json
announced_panels.json.tmp

# 停止スクリプトがBotに送るメモ。ふだんは存在しない
stop.request

__pycache__/
*.pyc
